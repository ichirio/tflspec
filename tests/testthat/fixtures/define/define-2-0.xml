<?xml version="1.0" encoding="ISO-8859-1"?>
<!-- A small Define-XML 2.0 for tflspec's tests: the 2.0 namespace, def:Class
     as an attribute, a translated text without xml:lang, the same variable
     in two datasets with different code lists. -->
<ODM xmlns="http://www.cdisc.org/ns/odm/v1.3"
     xmlns:xlink="http://www.w3.org/1999/xlink"
     xmlns:def="http://www.cdisc.org/ns/def/v2.0"
     ODMVersion="1.3.2" FileType="Snapshot" FileOID="DEF.TEST20"
     CreationDateTime="2026-10-09T00:00:00">
  <Study OID="ST.TEST20">
    <GlobalVariables>
      <StudyName>TEST20</StudyName>
      <StudyDescription>Define-XML 2.0 test</StudyDescription>
      <ProtocolName>TEST20</ProtocolName>
    </GlobalVariables>
    <MetaDataVersion OID="MDV.TEST20" Name="TEST20 ADaM" def:DefineVersion="2.0.0"
                     def:StandardName="ADaM-IG" def:StandardVersion="1.0">
      <ItemGroupDef OID="IG.ADVS" Name="ADVS" Repeating="Yes" IsReferenceData="No"
                    Purpose="Analysis" def:Structure="One record per subject per parameter per visit"
                    def:Class="BASIC DATA STRUCTURE">
        <Description><TranslatedText>Vital Signs Analysis Dataset</TranslatedText></Description>
        <ItemRef ItemOID="IT.ADVS.PARAMCD" OrderNumber="1" Mandatory="Yes"/>
        <ItemRef ItemOID="IT.ADVS.AVISIT" OrderNumber="2" Mandatory="No"/>
      </ItemGroupDef>
      <ItemGroupDef OID="IG.ADLB" Name="ADLB" Repeating="Yes" IsReferenceData="No"
                    Purpose="Analysis" def:Structure="One record per subject per parameter per visit"
                    def:Class="BASIC DATA STRUCTURE">
        <Description><TranslatedText>Laboratory Analysis Dataset</TranslatedText></Description>
        <ItemRef ItemOID="IT.ADLB.PARAMCD" OrderNumber="1" Mandatory="Yes"/>
        <ItemRef ItemOID="IT.ADLB.AVISIT" OrderNumber="2" Mandatory="No"/>
      </ItemGroupDef>
      <ItemDef OID="IT.ADVS.PARAMCD" Name="PARAMCD" DataType="text" Length="8">
        <Description><TranslatedText>Parameter Code</TranslatedText></Description>
        <CodeListRef CodeListOID="CL.VSPARAMCD"/>
      </ItemDef>
      <ItemDef OID="IT.ADVS.AVISIT" Name="AVISIT" DataType="text" Length="20">
        <Description><TranslatedText>Analysis Visit</TranslatedText></Description>
        <CodeListRef CodeListOID="CL.AVISIT"/>
      </ItemDef>
      <ItemDef OID="IT.ADLB.PARAMCD" Name="PARAMCD" DataType="text" Length="8">
        <Description><TranslatedText>Parameter Code</TranslatedText></Description>
        <CodeListRef CodeListOID="CL.LBPARAMCD"/>
      </ItemDef>
      <ItemDef OID="IT.ADLB.AVISIT" Name="AVISIT" DataType="text" Length="20">
        <Description><TranslatedText>Analysis Visit</TranslatedText></Description>
        <CodeListRef CodeListOID="CL.AVISIT"/>
      </ItemDef>
      <CodeList OID="CL.VSPARAMCD" Name="VS Parameter Code" DataType="text">
        <CodeListItem CodedValue="SYSBP" OrderNumber="1">
          <Decode><TranslatedText>Systolic Blood Pressure (mmHg)</TranslatedText></Decode>
        </CodeListItem>
        <CodeListItem CodedValue="DIABP" OrderNumber="2">
          <Decode><TranslatedText>Diastolic Blood Pressure (mmHg)</TranslatedText></Decode>
        </CodeListItem>
      </CodeList>
      <CodeList OID="CL.LBPARAMCD" Name="LB Parameter Code" DataType="text">
        <CodeListItem CodedValue="ALT">
          <Decode><TranslatedText>Alanine Aminotransferase (U/L)</TranslatedText></Decode>
        </CodeListItem>
      </CodeList>
      <CodeList OID="CL.AVISIT" Name="Analysis Visit" DataType="text">
        <EnumeratedItem CodedValue="Week 4" OrderNumber="2"/>
        <EnumeratedItem CodedValue="Baseline" OrderNumber="1"/>
        <EnumeratedItem CodedValue="Week 8" OrderNumber="3" def:ExtendedValue="Yes"/>
      </CodeList>
    </MetaDataVersion>
  </Study>
</ODM>
