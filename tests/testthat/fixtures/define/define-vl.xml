<?xml version="1.0" encoding="UTF-8"?>
<!-- A small Define-XML 2.1 for tflspec's tests: value-level metadata
     (def:ValueListDef, def:WhereClauseDef with RangeChecks) with the digits
     and the format of AVAL by parameter, and a code list of a parameter's
     values. -->
<ODM xmlns="http://www.cdisc.org/ns/odm/v1.3"
     xmlns:xlink="http://www.w3.org/1999/xlink"
     xmlns:def="http://www.cdisc.org/ns/def/v2.1"
     ODMVersion="1.3.2" FileType="Snapshot" FileOID="DEF.TESTVL"
     CreationDateTime="2026-10-30T00:00:00">
  <Study OID="ST.TESTVL">
    <GlobalVariables>
      <StudyName>TESTVL</StudyName>
      <StudyDescription>Define-XML 2.1 value-level test</StudyDescription>
      <ProtocolName>TESTVL</ProtocolName>
    </GlobalVariables>
    <MetaDataVersion OID="MDV.TESTVL" Name="TESTVL ADaM" def:DefineVersion="2.1.0">
      <def:Standards>
        <def:Standard OID="STD.1" Name="ADaMIG" Type="IG" Version="1.1" Status="Final"/>
      </def:Standards>
      <ItemGroupDef OID="IG.ADSL" Name="ADSL" Repeating="No" IsReferenceData="No"
                    Purpose="Analysis" def:Structure="One record per subject"
                    def:StandardOID="STD.1">
        <Description><TranslatedText xml:lang="en">Subject-Level Analysis Dataset</TranslatedText></Description>
        <ItemRef ItemOID="IT.ADSL.USUBJID" OrderNumber="1" Mandatory="Yes" KeySequence="1"/>
        <ItemRef ItemOID="IT.ADSL.SEX" OrderNumber="2" Mandatory="No"/>
        <ItemRef ItemOID="IT.ADSL.AGE" OrderNumber="3" Mandatory="No"/>
        <def:Class Name="SUBJECT LEVEL ANALYSIS DATASET"/>
      </ItemGroupDef>
      <ItemGroupDef OID="IG.ADLB" Name="ADLB" Repeating="Yes" IsReferenceData="No"
                    Purpose="Analysis" def:Structure="One record per subject per parameter per visit"
                    def:StandardOID="STD.1">
        <Description><TranslatedText xml:lang="en">Laboratory Analysis Dataset</TranslatedText></Description>
        <ItemRef ItemOID="IT.ADLB.USUBJID" OrderNumber="1" Mandatory="Yes" KeySequence="1"/>
        <ItemRef ItemOID="IT.ADLB.PARAMCD" OrderNumber="2" Mandatory="Yes" KeySequence="2"/>
        <ItemRef ItemOID="IT.ADLB.AVAL" OrderNumber="3" Mandatory="No"/>
        <def:Class Name="BASIC DATA STRUCTURE"/>
      </ItemGroupDef>
      <ItemDef OID="IT.ADSL.USUBJID" Name="USUBJID" DataType="text" Length="20">
        <Description><TranslatedText xml:lang="en">Unique Subject Identifier</TranslatedText></Description>
        <def:Origin Type="Predecessor"/>
      </ItemDef>
      <ItemDef OID="IT.ADSL.SEX" Name="SEX" DataType="text" Length="1">
        <Description><TranslatedText xml:lang="en">Sex</TranslatedText></Description>
        <CodeListRef CodeListOID="CL.SEX"/>
        <def:Origin Type="Predecessor"/>
      </ItemDef>
      <ItemDef OID="IT.ADSL.AGE" Name="AGE" DataType="integer" Length="3">
        <Description><TranslatedText xml:lang="en">Age</TranslatedText></Description>
        <def:Origin Type="Predecessor"/>
      </ItemDef>
      <ItemDef OID="IT.ADLB.USUBJID" Name="USUBJID" DataType="text" Length="20">
        <Description><TranslatedText xml:lang="en">Unique Subject Identifier</TranslatedText></Description>
        <def:Origin Type="Predecessor"/>
      </ItemDef>
      <ItemDef OID="IT.ADLB.PARAMCD" Name="PARAMCD" DataType="text" Length="8">
        <Description><TranslatedText xml:lang="en">Parameter Code</TranslatedText></Description>
        <CodeListRef CodeListOID="CL.LBPARAMCD"/>
        <def:Origin Type="Assigned"/>
      </ItemDef>
      <ItemDef OID="IT.ADLB.AVAL" Name="AVAL" DataType="float" Length="8" SignificantDigits="2"
               def:DisplayFormat="8.2">
        <Description><TranslatedText xml:lang="en">Analysis Value</TranslatedText></Description>
        <def:ValueListRef ValueListOID="VL.ADLB.AVAL"/>
        <def:Origin Type="Derived"/>
      </ItemDef>
      <ItemDef OID="IT.ADLB.AVAL.ALT" Name="AVAL" DataType="float" Length="8" SignificantDigits="0"
               def:DisplayFormat="8.0">
        <Description><TranslatedText xml:lang="en">Analysis Value (ALT, U/L)</TranslatedText></Description>
        <def:Origin Type="Derived"/>
      </ItemDef>
      <ItemDef OID="IT.ADLB.AVAL.BILI" Name="AVAL" DataType="float" Length="8" SignificantDigits="1"
               def:DisplayFormat="8.1">
        <Description><TranslatedText xml:lang="en">Analysis Value (BILI, umol/L)</TranslatedText></Description>
        <def:Origin Type="Derived"/>
      </ItemDef>
      <ItemDef OID="IT.ADLB.AVAL.HEM" Name="AVAL" DataType="float" Length="8" SignificantDigits="0"
               def:DisplayFormat="8.0">
        <Description><TranslatedText xml:lang="en">Analysis Value (hematology)</TranslatedText></Description>
        <def:Origin Type="Derived"/>
      </ItemDef>
      <def:ValueListDef OID="VL.ADLB.AVAL">
        <ItemRef ItemOID="IT.ADLB.AVAL.ALT" OrderNumber="1" Mandatory="No">
          <def:WhereClauseRef WhereClauseOID="WC.ADLB.AVAL.ALT"/>
        </ItemRef>
        <ItemRef ItemOID="IT.ADLB.AVAL.BILI" OrderNumber="2" Mandatory="No">
          <def:WhereClauseRef WhereClauseOID="WC.ADLB.AVAL.BILI"/>
        </ItemRef>
        <ItemRef ItemOID="IT.ADLB.AVAL.HEM" OrderNumber="3" Mandatory="No">
          <def:WhereClauseRef WhereClauseOID="WC.ADLB.AVAL.HEM"/>
        </ItemRef>
      </def:ValueListDef>
      <def:WhereClauseDef OID="WC.ADLB.AVAL.ALT">
        <RangeCheck Comparator="EQ" SoftHard="Soft" def:ItemOID="IT.ADLB.PARAMCD">
          <CheckValue>ALT</CheckValue>
        </RangeCheck>
      </def:WhereClauseDef>
      <def:WhereClauseDef OID="WC.ADLB.AVAL.BILI">
        <RangeCheck Comparator="EQ" SoftHard="Soft" def:ItemOID="IT.ADLB.PARAMCD">
          <CheckValue>BILI</CheckValue>
        </RangeCheck>
      </def:WhereClauseDef>
      <def:WhereClauseDef OID="WC.ADLB.AVAL.HEM">
        <RangeCheck Comparator="IN" SoftHard="Soft" def:ItemOID="IT.ADLB.PARAMCD">
          <CheckValue>HGB</CheckValue>
          <CheckValue>PLAT</CheckValue>
        </RangeCheck>
      </def:WhereClauseDef>
      <CodeList OID="CL.SEX" Name="Sex" DataType="text">
        <CodeListItem CodedValue="M" OrderNumber="1">
          <Decode><TranslatedText xml:lang="en">Male</TranslatedText></Decode>
        </CodeListItem>
        <CodeListItem CodedValue="F" OrderNumber="2">
          <Decode><TranslatedText xml:lang="en">Female</TranslatedText></Decode>
        </CodeListItem>
      </CodeList>
      <CodeList OID="CL.LBPARAMCD" Name="Lab Parameter Code" DataType="text">
        <CodeListItem CodedValue="ALT" OrderNumber="1">
          <Decode><TranslatedText xml:lang="en">Alanine Aminotransferase (U/L)</TranslatedText></Decode>
        </CodeListItem>
        <CodeListItem CodedValue="BILI" OrderNumber="2">
          <Decode><TranslatedText xml:lang="en">Bilirubin (umol/L)</TranslatedText></Decode>
        </CodeListItem>
        <CodeListItem CodedValue="HGB" OrderNumber="3">
          <Decode><TranslatedText xml:lang="en">Hemoglobin (g/L)</TranslatedText></Decode>
        </CodeListItem>
        <CodeListItem CodedValue="PLAT" OrderNumber="4">
          <Decode><TranslatedText xml:lang="en">Platelets (10^9/L)</TranslatedText></Decode>
        </CodeListItem>
      </CodeList>
    </MetaDataVersion>
  </Study>
</ODM>
